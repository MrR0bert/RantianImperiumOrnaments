                    <PlayerLogo>
                        <DefaultLogo>data/mrr0b3rt/ui/logos/large/mrr0b3rt_rantian_symbol_logo.png</DefaultLogo>
                        <MiniLogo>data/mrr0b3rt/ui/logos/small/mrr0b3rt_rantian_symbol_logo.png</MiniLogo>
                    </PlayerLogo>
                    <Locked>
