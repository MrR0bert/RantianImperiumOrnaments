<ModOps>
    <Group>
        <!-- Trigger the newspaper -->
        <ModOp Type="addNextSibling" GUID="130252">
            <Asset>
                <Template>Trigger</Template>
                <Values>
                    <Standard>
                        <GUID>1500031010</GUID>
                        <Name>Trigger_SpecialNewsPaper_TwoYearAnnoverary</Name>
                        <IconFilename>data/ui/2kimages/main/3dicons/newspaper/icon_anarchist_newspaper_02.png</IconFilename>
                    </Standard>
                    <Trigger>
                        <TriggerCondition>
                            <Template>ConditionAlwaysTrue</Template>
                            <Values>
                                <Condition/>
                                <ConditionAlwaysTrue/>
                            </Values>
                        </TriggerCondition>
                        <TriggerActions>
                            <Item>
                                <TriggerAction>
                                    <Template>ActionForceNewspaper</Template>
                                    <Values>
                                        <Action/>
                                        <ActionForceNewspaper>
                                            <Articles>
                                                <Item>
                                                    <Article>1500031011</Article>
                                                </Item>
                                            </Articles>
                                            <OpenNewspaperUI>1</OpenNewspaperUI>
                                            <OpenNewspaperType>SpecialEdition</OpenNewspaperType>
                                            <PamsyWelcomeRequiredAsset>1500031014</PamsyWelcomeRequiredAsset>
                                        </ActionForceNewspaper>
                                    </Values>
                                </TriggerAction>
                            </Item>
                        </TriggerActions>
                        <SubTriggers>
                            <Item>
                                <SubTrigger>
                                    <Template>AutoCreateTrigger</Template>
                                    <Values>
                                        <Trigger>
                                            <TriggerCondition>
                                                <Template>ConditionIsMultiplayer</Template>
                                                <Values>
                                                    <Condition/>
                                                    <ConditionIsMultiplayer/>
                                                    <ConditionPropsNegatable>
                                                        <NegateCondition>1</NegateCondition>
                                                    </ConditionPropsNegatable>
                                                </Values>
                                            </TriggerCondition>
                                        </Trigger>
                                    </Values>
                                </SubTrigger>
                            </Item>
                        </SubTriggers>
                        <ResetTrigger>
                            <IsBaseAutoCreateAsset>1</IsBaseAutoCreateAsset>
                            <Values>
                                <EmptyAutoCreateValue/>
                            </Values>
                        </ResetTrigger>
                    </Trigger>
                    <TriggerSetup>
                        <AutoRegisterTrigger>1</AutoRegisterTrigger>
                    </TriggerSetup>
                </Values>
            </Asset>
        </ModOp>

        <ModOp Type="addNextSibling" GUID="136117">
            <Asset>
                <Template>NewspaperSpecialEditionArticle</Template>
                <Values>
                    <Standard>
                        <GUID>1500031011</GUID>
                        <Name>SpecialNewsPaper_Article_TwoYearAnnoverary</Name>
                    </Standard>
                    <NewspaperSpecialEditionArticle>
                        <SpecialEditionHeadline>1500031012</SpecialEditionHeadline>
                        <SpecialEditionSubline>1500031013</SpecialEditionSubline>
                        <SpecialEditionImage>123875</SpecialEditionImage>
                    </NewspaperSpecialEditionArticle>
                </Values>
            </Asset>
        </ModOp>

        <ModOp Type="addNextSibling" GUID="1500031010">
            <Asset>
                <Template>SimpleAsset</Template>
                <Values>
                    <Standard>
                        <GUID>1500031014</GUID>
                        <Name>PaMSy_SpecialEdition_RantiusAnnoversary_IntroNewspaper</Name>
                    </Standard>
                </Values>
            </Asset>
        </ModOp>
    </Group>
</ModOps>